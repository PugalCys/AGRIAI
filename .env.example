# ============================================================
# AgriGuard AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# Supabase (REQUIRED for real data)
# ============================================================
# 1. Go to https://supabase.com and create a free project
# 2. Go to Settings → API in your project dashboard
# 3. Copy your Project URL and Anon Key below

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# AI Provider (at least one REQUIRED for crop analysis)
# ============================================================
# Option A: Google Gemini (FREE tier available)
# Get yours at: https://aistudio.google.com/apikey

VITE_GEMINI_API_KEY=your-gemini-api-key

# Option B: OpenAI GPT-4o (Paid)
# Get yours at: https://platform.openai.com/api-keys

VITE_OPENAI_API_KEY=your-openai-api-key

# ============================================================
# Notes:
# ============================================================
# - With NO keys: App runs in DEMO MODE (mock data)
# - With Supabase: Real user accounts & data storage
# - With AI key: Real crop disease analysis
# - With both: Full production experience
#
# Required tables in Supabase (see SUPABASE_SETUP.md):
# - profiles
# - farms
# - crops
# - reports
# - expert_reviews
# - notifications
